FROM node:22-bookworm-slim AS deps
RUN corepack enable
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/stack-core/package.json packages/stack-core/package.json
COPY packages/github/package.json packages/github/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/decision-engine/package.json packages/decision-engine/package.json
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm --filter @stackoperator/database generate

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable
COPY --from=build /app /app
CMD ["sh", "-c", "pnpm --filter @stackoperator/database migrate:deploy && pnpm --filter @stackoperator/worker start"]
