# PostgreSQL (local Compose maps postgres:5432 → localhost:5432)
DATABASE_URL=postgresql://stackoperator:stackoperator@localhost:5432/stackoperator

# GitHub App (from the manifest flow or App settings)
GITHUB_APP_ID=
GITHUB_APP_SLUG=stackoperator
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URL of the web app (used for OAuth callback and check-run details)
APP_BASE_URL=http://localhost:3000

# Cookie signing secret (32+ characters)
SESSION_SECRET=change-me-to-a-long-random-string

# Local dashboard only: skip GitHub OAuth and show every installation.
# Never enable this in a shared or production environment.
DASHBOARD_OPEN_ACCESS=true

LOG_LEVEL=info

# GitHub-hosted Linux 2-core list price. Estimates only.
LINUX_2CORE_USD_PER_MINUTE=0.006
DEFAULT_ESTIMATED_MINUTES=15
